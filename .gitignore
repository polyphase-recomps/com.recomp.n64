# ROM images and extracted game data never belong in this repository.
*.z64
*.n64
*.v64
*.n64pak

# Build output (/Lib/ is anchored: on case-insensitive filesystems a bare Lib/ also matched
# ThirdParty/N64Recomp/lib, the vendored dependencies)
build/
/Lib/

# Tooling
__pycache__/
*.pyc
.vs/
*.vcxproj.user
# Machine-specific include paths, regenerated by the editor
# (Tools > Addons > Regenerate Native Addon Dependencies).
.vscode/
