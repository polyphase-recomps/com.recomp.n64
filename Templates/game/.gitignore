# --- Game code and data: never commit ---------------------------------------------------
# The library holds the game recompiled from YOUR OWN ROM; the generated C is game code too.
Lib/
Native/build/
build/
# ROM images, wherever they end up.
*.z64
*.n64
*.v64
*.n64pak
# Recomp (live) data: copied from Recomp/ by build_recomp.ps1 -Live
/Assets/Recomp/Live/

# --- Tooling -----------------------------------------------------------------------------
__pycache__/
*.pyc
.vs/
*.vcxproj.user
# Machine-specific include paths, regenerated by the editor
# (Tools > Addons > Regenerate Native Addon Dependencies).
.vscode/
